# Copy this file to .env and fill in your Raindrop token.
# Keep .env private: it contains credentials.

RAINDROP_TOKEN=your_raindrop_token_here
# Alternative supported name:
# RAINDROP_ACCESS_TOKEN=your_raindrop_token_here

RAINDROP_LOG_DIR=logs
RAINDROP_LOG_MAX_LINES=3000

RAINDROP_DOWNLOAD_DELAY_MS=0
RAINDROP_DOWNLOAD_JITTER_MS=0

RAINDROP_REQUEST_TIMEOUT_SECONDS=25
RAINDROP_REQUEST_RETRIES=2

# Optional: set this when a site blocks the default crawler User-Agent.
# Example: copy your browser's User-Agent string.
# RAINDROP_USER_AGENT=Mozilla/5.0 ...
